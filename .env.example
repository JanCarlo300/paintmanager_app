# Copie este arquivo para ".env" e preencha com os dados do seu projeto
# Supabase (Project Settings > API).
#
# ATENÇÃO: o .env é empacotado DENTRO do APK (é um asset do Flutter).
# Coloque aqui SOMENTE as duas chaves públicas abaixo. Chaves de
# administrador (service_role, access token, senha do banco) NUNCA entram
# no .env: quem tiver o APK teria acesso total ao banco, ignorando o RLS.
# Guarde-as em ".env.servidor" (fora do app e do git) se precisar delas
# para a CLI do Supabase.

SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua-chave-anon-publica
